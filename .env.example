# ─── Shared / Database ───────────────────────────────────────
POSTGRES_DB=appi
POSTGRES_USER=appi
POSTGRES_PASSWORD=change_me_local
POSTGRES_PORT=5437
DATABASE_URL=postgresql://appi:change_me_local@localhost:5437/appi?schema=public

# Docker internal URLs (used by compose services)
# DATABASE_URL=postgresql://appi:change_me_local@db:5432/appi?schema=public

REDIS_PORT=6382
REDIS_URL=redis://localhost:6382

# ─── Site (middleware reads API_INTERNAL_URL for construction mode) ─
# API_INTERNAL_URL must reach the API from the frontend container/host

# Optional: external cache purge (POST /api/revalidate with x-revalidate-secret header)
REVALIDATE_SECRET=dev_revalidate_secret

# ─── Seed (packages/database/prisma/seed.ts) ─────────────────
# Dev default admin — change before production; seed skipped in production unless SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@appi.local
SEED_ADMIN_PASSWORD=AdminChangeMe123!
SEED_ADMIN_NAME=APPI Admin
SEED_MEMBER_EMAIL=member@appi.local
SEED_MEMBER_PASSWORD=MemberChangeMe123!
SEED_MEMBER_NAME=Demo Member

# ─── API (apps/api) ──────────────────────────────────────────
API_PORT=4000
UPLOAD_DIR=./uploads
CURRENT_SUMMIT_YEAR=2025
JWT_SECRET=dev_jwt_secret_min_32_characters_long
JWT_REFRESH_SECRET=dev_refresh_secret_min_32_chars
ADMIN_API_KEY=dev_admin_key
CORS_ORIGIN=http://localhost:3010
RESEND_API_KEY=
FORM_FROM_EMAIL=noreply@example.com
FORM_TO_EMAIL=secretariat@example.com

# Internal URL for Next.js rewrites (server-side)
API_INTERNAL_URL=http://localhost:4000

# ─── Frontend (apps/frontend) ────────────────────────────────
FRONTEND_PORT=3010
NEXT_PUBLIC_SITE_URL=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:3010

# ─── Production / Coolify (VPS) ───────────────────────────────
# Full template: copy .env.coolify.example into Coolify env vars
# Guide: docs/DEPLOY-COOLIFY.md
# DATABASE_URL=postgresql://appi:PASSWORD@db:5432/appi?schema=public
# NEXT_PUBLIC_SITE_URL=https://appi.yourdomain.org
# CORS_ORIGIN=https://appi.yourdomain.org
# SEED_ADMIN_ENABLED=true   # first deploy only

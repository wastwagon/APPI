# Copy these into Coolify → Your APPI stack → Environment Variables
# Replace CHANGE_ME values before first deploy.

# ─── Database (service hostname: db) ───────────────────────
POSTGRES_DB=appi
POSTGRES_USER=appi
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_URL=postgresql://appi:CHANGE_ME_strong_db_password@db:5432/appi?schema=public

# ─── Public URLs (your real domain) ──────────────────────────
NEXT_PUBLIC_SITE_URL=https://appi.yourdomain.org
NEXT_PUBLIC_API_URL=https://appi.yourdomain.org
CORS_ORIGIN=https://appi.yourdomain.org

# ─── Auth (min 32 characters each) ─────────────────────────
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_at_least_32_chars

# ─── First deploy only: create admin + seed CMS/media ───────
# Set to true for the FIRST successful deploy, then set back to false and redeploy.
SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@yourdomain.org
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
SEED_ADMIN_NAME=APPI Admin

# Optional demo member (leave password empty to skip)
SEED_MEMBER_EMAIL=
SEED_MEMBER_PASSWORD=

# ─── Email (optional, Resend) ──────────────────────────────
RESEND_API_KEY=
FORM_FROM_EMAIL=noreply@yourdomain.org
FORM_TO_EMAIL=secretariat@yourdomain.org

# ─── Optional ───────────────────────────────────────────────
ADMIN_API_KEY=
REVALIDATE_SECRET=
CURRENT_SUMMIT_YEAR=2025
COOLIFY_PORT=3000

# Do NOT set API_INTERNAL_URL in Coolify — compose sets http://api:4000 inside the stack.
